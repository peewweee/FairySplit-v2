# Copy to .env.local. Both values are public by design — the publishable key
# only ever acts as the caller's own identity, and row-level security decides
# what that identity may read.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. The address invite links point at (never localhost). Defaults to
# the live site; set it when the app moves to its own domain.
# NEXT_PUBLIC_SITE_URL=https://fairy-split-v2.vercel.app
